# OpenAI-compatible provider. Never commit real credentials.
TALENTGRAPH_LLM_BASE_URL=https://your-provider.example
TALENTGRAPH_LLM_API_KEY=replace-with-rotated-key
TALENTGRAPH_LLM_MODEL=your-model-name
TALENTGRAPH_LLM_TIMEOUT_SECONDS=180
TALENTGRAPH_LLM_RETRIES=1
TALENTGRAPH_LLM_TRUST_ENV_PROXY=0
TALENTGRAPH_RESUME_LLM_TIMEOUT_SECONDS=60
TALENTGRAPH_RESUME_LLM_RETRIES=0
# main: use TALENTGRAPH_LLM_*; vision: use TALENTGRAPH_VISION_* for resume semantics too.
TALENTGRAPH_RESUME_LLM_SOURCE=main
TALENTGRAPH_RESUME_LLM_MAX_TOKENS=1600
TALENTGRAPH_RESUME_LLM_REPAIR_MAX_TOKENS=2200
TALENTGRAPH_RESUME_LLM_INPUT_CHARS=3000
TALENTGRAPH_DIALOGUE_LLM_MODEL=
TALENTGRAPH_DIALOGUE_LLM_TIMEOUT_SECONDS=25
TALENTGRAPH_DIALOGUE_LLM_MAX_TOKENS=220
TALENTGRAPH_PROFILE_LLM_MODEL=
TALENTGRAPH_PROFILE_LLM_TIMEOUT_SECONDS=30
TALENTGRAPH_PROFILE_LLM_MAX_TOKENS=520
TALENTGRAPH_LLM_LIVE_NORMALIZATION=0

# Optional OpenAI-compatible vision model for scanned/image resumes.
TALENTGRAPH_VISION_BASE_URL=https://your-vision-provider.example
TALENTGRAPH_VISION_API_KEY=replace-with-rotated-key
TALENTGRAPH_VISION_MODEL=your-vision-model-name
TALENTGRAPH_VISION_TIMEOUT_SECONDS=180
TALENTGRAPH_VISION_RETRIES=1

# Optional request timeout in the application can remain at its default.

